#!/system/bin/sh
# vaultctl - manage the encrypted vault and per-app allow rules.
# Run as root:  su -c "vaultctl <cmd>"
#
# rules.conf format (one per line):
#   <package>|<target folder in app's storage>|<vault subfolder>
# e.g. com.snapchat.android|Download/SnapVault|snapchat
# The app sees /storage/emulated/<user>/<target> as the decrypted vault subfolder.

V=/data/adb/vault
GCFS=$V/bin/gocryptfs
RULES=$V/rules.conf
CTX="u:object_r:vault_file:s0"

die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" = "0" ] || die "run as root"

is_mounted() { grep -q " $V/plain " /proc/mounts; }

case "$1" in
  init)
    [ -x "$GCFS" ] || die "missing $GCFS"
    [ -z "$(ls -A $V/cipher)" ] || die "vault already initialised"
    "$GCFS" -init "$V/cipher"
    ;;
  unlock)
    [ -x "$GCFS" ] || die "missing $GCFS"
    is_mounted && die "already unlocked"
    LOG=$V/unlock.log
    : > "$LOG"
    IFS= read -r PW
    # Mount in the global (init) namespace so app namespaces can bind from it.
    try_mount() {
      printf '%s\n' "$PW" | nsenter -t 1 -m -- "$GCFS" -debug -allow_other $1 "$V/cipher" "$V/plain" >> "$LOG" 2>&1
    }
    echo "== try 1: with SELinux label" >> "$LOG"
    try_mount "-ko context=$CTX"
    if ! is_mounted; then
      echo "== try 2: without label" >> "$LOG"
      try_mount ""
      if is_mounted; then
        echo "unlocked WITHOUT SELinux label (apps may be denied; see unlock.log)"
        PW=""; exit 0
      fi
    fi
    PW=""
    if is_mounted; then echo "unlocked"; exit 0; fi
    logcat -d 2>/dev/null | grep -i "avc: *denied" | grep -i "fuse\|vault" | tail -n 4 >> "$LOG"
    die "unlock failed: $(grep -v '^==' "$LOG" | tail -n 4 | tr '\n' ' ')"
    ;;
  lock)
    nsenter -t 1 -m -- umount -l "$V/plain" 2>/dev/null
    echo "locked (apps already running keep their mounts until restarted)"
    ;;
  init-auto)
    [ -x "$GCFS" ] || die "missing $GCFS"
    [ -z "$(ls -A $V/cipher)" ] || die "vault already initialised"
    ( umask 077; tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 40 > "$V/.key"; echo >> "$V/.key" )
    chmod 600 "$V/.key"
    "$GCFS" -init "$V/cipher" < "$V/.key" > /dev/null 2>&1 || { rm -f "$V/.key"; die "init failed"; }
    echo "created"
    ;;
  autounlock)
    [ -f "$V/.key" ] || { echo "no auto key"; exit 0; }
    is_mounted && { echo "already unlocked"; exit 0; }
    "$0" unlock < "$V/.key"
    ;;
  remember)
    IFS= read -r PW
    ( umask 077; printf '%s\n' "$PW" > "$V/.key" )
    chmod 600 "$V/.key"; PW=""
    echo "auto-unlock on"
    ;;
  forget)
    rm -f "$V/.key"; echo "auto-unlock off"
    ;;
  autostate)
    [ -f "$V/.key" ] && echo on || echo off
    ;;
  initialized)
    [ -f "$V/cipher/gocryptfs.conf" ] && echo yes || echo no
    ;;
  status)
    is_mounted && echo "unlocked" || echo "locked"
    ;;
  allow)
    pkg="$2"; target="$3"; sub="$4"
    [ -n "$pkg" ] && [ -n "$target" ] && [ -n "$sub" ] || die "usage: allow <pkg> <target> <subfolder>"
    grep -v "^$pkg|" "$RULES" > "$RULES.tmp"; mv "$RULES.tmp" "$RULES"
    echo "$pkg|$target|$sub" >> "$RULES"
    # The mount target must exist in real shared storage.
    mkdir -p "/data/media/0/$target"
    chown media_rw:media_rw "/data/media/0/$target" 2>/dev/null
    is_mounted && mkdir -p "$V/plain/$sub"
    echo "allowed $pkg -> $target (restart the app)"
    ;;
  deny)
    [ -n "$2" ] || die "usage: deny <pkg>"
    grep -v "^$2|" "$RULES" > "$RULES.tmp"; mv "$RULES.tmp" "$RULES"
    echo "removed $2 (restart the app)"
    ;;
  diag)
    echo "== module"
    grep -E '^version=' /data/adb/modules/vaultmount/module.prop
    ls -l /data/adb/modules/vaultmount/zygisk/ 2>&1 | sed 's/^/  /'
    echo "== zygisk modules installed"
    ls /data/adb/modules 2>/dev/null | grep -i zygisk | sed 's/^/  /'
    echo "== vault"
    is_mounted && echo "  unlocked" || echo "  LOCKED"
    echo "  auto-unlock: $([ -f $V/.key ] && echo on || echo off)"
    echo "== rules"
    sed 's/^/  /' "$RULES"
    echo "== module log (companion file)"
    tail -n 12 "$V/module.log" 2>/dev/null | sed 's/^/  /'
    echo "== module log (logcat)"
    logcat -d -s VaultMount 2>/dev/null | tail -n 10 | sed 's/^/  /'
    while IFS='|' read -r pkg target sub; do
      [ -n "$pkg" ] || continue
      echo "== $pkg"
      pid=$(pidof "$pkg" | awk '{print $1}')
      if [ -z "$pid" ]; then echo "  NOT RUNNING (open it, then re-run)"; continue; fi
      echo "  pid $pid"
      echo "  mounts in app view:"
      nsenter -t "$pid" -m -- sh -c "grep -E '$sub|vault|/$target' /proc/self/mounts" 2>&1 | sed 's/^/    /'
      echo "  listing /storage/emulated/0/$target in app view:"
      nsenter -t "$pid" -m -- ls -la "/storage/emulated/0/$target" 2>&1 | head -n 8 | sed 's/^/    /'
      echo "  vault side:"
      ls -la "$V/plain/$sub" 2>&1 | head -n 8 | sed 's/^/    /'
    done < "$RULES"
    echo "== avc denials: sockets / zygisk / snapchat (last 15)"
    logcat -d 2>/dev/null | grep -i "avc: *denied" | grep -i "unix_stream_socket\|zygisk\|rezygisk\|zygiskd\|snapchat\|vault_file\|fuse" | tail -n 15 | sed 's/^/  /'
    echo "== module log (companion file, full tail)"
    tail -n 25 "$V/module.log" 2>/dev/null | sed 's/^/  /'
    ;;
  list)
    cat "$RULES"
    ;;
  *)
    echo "usage: vaultctl diag|initialized|init|init-auto|autounlock|remember|forget|autostate|unlock|lock|status|allow <pkg> <target> <sub>|deny <pkg>|list"
    ;;
esac
